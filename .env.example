# Copy to .env (chmod 600). Blank value = use the default shown.
# --- Ingest ---
OBS_INGEST_PORT=1935                  # local RTMP port OBS publishes to (rtmp://127.0.0.1:PORT/live, key obs)
# --- YouTube Live (YouTube Studio > Go Live > Stream > Stream settings) ---
YOUTUBE_RTMP_URL=rtmps://a.rtmps.youtube.com/live2
YOUTUBE_STREAM_KEY=                   # secret; Stream key field
YOUTUBE_LIVE_URL=                     # optional: watch URL of the live stream, enables YouTube chat signal
# --- Twitch (dashboard.twitch.tv > Settings > Stream) ---
TWITCH_RTMP_URL=rtmps://ingest.global-contribute.live-video.net/app  # nearest ingest: https://help.twitch.tv/s/twitch-ingest-recommendation
TWITCH_STREAM_KEY=                    # secret; Primary Stream key
TWITCH_CHANNEL=                       # your channel login name, enables Twitch chat signal (anonymous read)
# --- Detection ---
BUFFER_MINUTES=20
PRE_ROLL=20
POST_ROLL=8
CANDIDATE_THRESHOLD=3.0
W_AUDIO=1.0
W_CHAT=1.0
COOLDOWN_SECONDS=90
# --- Judge (Ollama at localhost:11434; `ollama pull qwen3-vl:8b`) ---
JUDGE_MODEL=qwen3-vl:8b
JUDGE_MIN_SCORE=7
JUDGE_CUE_BONUS=1                      # added to the model score when transcript keyword cues match (max 10)
WHISPER_MODEL=models/ggml-base.en.bin # ggml model, from https://huggingface.co/ggerganov/whisper.cpp
# --- Optional Claude judge (headless `claude -p`, uses your Claude Code plan; local judge always runs first) ---
CLAUDE_JUDGE=off                      # off | shadow (log only) | on (Claude decides, falls back to local on error)
CLAUDE_JUDGE_MODEL=sonnet             # sonnet | haiku
CLAUDE_JUDGE_MIN_LOCAL=5              # only candidates the local judge scores >= this go to Claude
CLAUDE_JUDGE_MAX_PER_HOUR=10
CLAUDE_JUDGE_TIMEOUT=120              # seconds per call
# --- Render ---
FACECAM=auto                          # auto | off: stack gameplay over your facecam when one is found
FACECAM_BOX=                          # optional x,y,w,h in source pixels, e.g. 1500,700,360,270 (beats detection)
CROP_MODE=blur                        # blur | center
CAPTIONS=true
# --- Upload ---
DRY_RUN=true                          # keep true until credentials are set up and tested
MAX_POSTS_PER_HOUR=4
DELETE_CLIPS_AFTER_UPLOAD=false
HASHTAGS_DEFAULT=                     # blank = hashtags from the current game style pack
# YouTube Shorts: Google Cloud Console > APIs > YouTube Data API v3 > OAuth client (Desktop app), download JSON
YOUTUBE_CLIENT_SECRET_FILE=secrets/client_secret.json
YOUTUBE_PRIVACY=public                # public | unlisted | private
# TikTok: https://developers.tiktok.com/apps (add Login Kit + Content Posting API; redirect URI must be registered)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=                 # secret
TIKTOK_REDIRECT_URI=http://127.0.0.1:8765/callback/
TIKTOK_MODE=draft                     # draft (inbox, video.upload) | direct (video.publish)
# Instagram Reels: https://developers.facebook.com/apps (Instagram API with Facebook Login, IG professional account)
IG_USER_ID=
IG_ACCESS_TOKEN=                      # secret; long-lived token with instagram_content_publish
IG_GRAPH_VERSION=v27.0
# --- Stream title & thumbnail (python -m kit.stream_meta [--apply] [--frame PATH]) ---
STREAM_META=off                       # off | auto (generate + apply to YouTube at startup)
STREAM_GAME=Grand Theft Auto VI
STREAM_GAME_SHORT=                     # short label for overlays, e.g. GTA VI (blank = STREAM_GAME)
STREAMER_NAME=                         # name on the overlay plate and promo posts (blank = channel handle)
SCENE_KICKER=                          # line above STARTING SOON, e.g. Tonight in Vice City (blank = Tonight on stream)
STREAM_ANGLE=first time ever playing GTA; total beginner to open-world crime games
STREAM_GEN=                           # codex | ollama | template (blank = codex if logged in with ChatGPT, else ollama, else template)
STREAM_THUMB=                         # codex | local (blank = codex when available)
LINK_YOUTUBE=                         # channel links, used in descriptions, captions and the Twitch bio
LINK_TWITCH=
LINK_TIKTOK=
LINK_INSTAGRAM=
LINK_SHORTS=                           # only in the full block, e.g. https://www.youtube.com/@x/shorts
LINK_DISCORD=                          # permanent invite, e.g. https://discord.gg/xxxx
LINK_TIP=                              # tip page, e.g. https://streamelements.com/<channel>/tip
LINK_WEBSITE=                          # only in the full "Where to find me" block
FACE_REF=                             # optional: image of your face; sent to ChatGPT (Codex) so the thumbnail character looks like you
STYLE_REF=                            # optional image whose look the thumbnail character takes (e.g. hero render)
THUMB_TYPE=gta                        # gta (heavy outlined type, sunset accent) or clean
THUMB_FONT=                           # optional font file for thumbnail text, e.g. Pricedown
STREAM_SCHEDULE=                      # optional free text, e.g. Live Mon/Wed/Fri 8pm
STREAM_ABOUT=                         # optional "About me" paragraph for the stream description
STREAM_GOAL=                          # optional, e.g. Road to 1200 subs
OLLAMA_URL=http://localhost:11434
THUMB_LIVE=false                      # true adds a red LIVE badge; only while live, regenerate after
THUMB_LOOK=hero                       # hero (STYLE_REF look) or creator (photo-composite, game outfit)
THUMB_LAYOUT=stake                    # stake (you + threat/goal) or poster (centred key art, game emblem behind)
THUMB_POSE=                           # poster pose, blank = finger-guns at the camera
THUMB_EXPRESSION=                     # poster expression override, blank = subtle confident smile
LIKENESS_MAX=0.40                     # regenerate the thumbnail face until dlib distance to FACE_REF <= this
LIKENESS_TRIES=3                      # max image generations per thumbnail (keeps the closest)
LIKENESS_PYTHON=python3               # a Python with face_recognition installed
THUMB_FACE_SIDE=left                  # left, right or front: which side of your face the thumbnail shows
# --- Live chat bot (python -m kit.chatbot [--demo]; OBS Browser Source http://127.0.0.1:PORT/overlay) ---
CHATBOT_PORT=8777                     # local port of the overlay server (127.0.0.1 only)
DISCORD_WEBHOOK_URL=                  # secret; optional: paid events + raids are posted here as embeds
DISCORD_WELCOMES=false                # true also posts first-time-chatter welcomes to Discord
TWITCH_BOT_NICK=                      # optional: bot account login; with the token below the bot replies in Twitch chat
TWITCH_BOT_OAUTH=                     # secret; token with chat:read chat:edit (twitchtokengenerator.com or Twitch CLI)
WELCOME_TEMPLATE=Welcome to the stream, {user}! Glad you're here, sit back and enjoy.   # {user} {platform} {discord}; LINK_DISCORD is appended when set
THANKS_TEMPLATE=Huge thanks {user} for the {amount}! You're awesome.   # {user} {amount} {platform}
CHATBOT_COOLDOWN=8                    # min seconds between Twitch chat replies
# Chat bot commands (!discord !tip !socials !schedule !uptime !lurk !clip !commands) use CHATBOT_COOLDOWN seconds per command.
# Rotating timer message (tip / discord / socials) to Twitch chat and the /layout ticker: every TIMER_MINUTES (0 = off),
# only if at least TIMER_MIN_CHAT chat messages arrived since the last one.
TIMER_MINUTES=20
TIMER_MIN_CHAT=5
# Countdown videos (python -m kit.explainer RECORDING.mkv)
EXPLAINER_MODEL=sonnet                # Claude Code plan model that writes the script (sonnet or haiku)
VOICE_PYTHON=voice/venv/bin/python                          # venv python of the local voice clone
VOICE_DIR=voice                                               # folder with say.py
